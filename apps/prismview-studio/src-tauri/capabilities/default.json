{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for PrismView Studio, Desktop Wallpaper, and Standalone Widgets",
  "windows": ["main", "wallpaper", "wallpaper-*", "widget-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-position",
    "core:window:allow-set-size"
  ]
}
